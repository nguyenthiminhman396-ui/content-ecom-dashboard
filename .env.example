# ============================================
# Bảo mật (CHỈ đọc ở server — /api/*)
# ============================================
# Secret ký cookie phiên đăng nhập + link chia sẻ. Chuỗi ngẫu nhiên ≥ 32 ký tự:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Đổi secret = đăng xuất mọi người + mọi link chia sẻ cũ hết hiệu lực.
AUTH_SECRET=

# Tài khoản khởi tạo (4 vai trò). KHÔNG dùng tiền tố VITE_ — biến VITE_* bị nhúng vào JS gửi xuống trình duyệt.
# (Server vẫn đọc tên cũ VITE_ACCOUNT_* nếu chưa đổi, nhưng nên đổi sang tên mới.)
# Lần đăng nhập đầu, tài khoản được lưu vào DB (mật khẩu đã hash); sau đó đổi mật khẩu trong app.
ACCOUNT_ADMIN_EMAIL=admin@example.com
ACCOUNT_ADMIN_PASS=
ACCOUNT_ADMIN_NAME=Admin

ACCOUNT_LEADER_EMAIL=leader@example.com
ACCOUNT_LEADER_PASS=
ACCOUNT_LEADER_NAME=Leader

ACCOUNT_MEMBER_EMAIL=member@example.com
ACCOUNT_MEMBER_PASS=
ACCOUNT_MEMBER_NAME=Member

# Client: để trống ACCOUNT_CLIENT_PASS = đăng nhập không cần mật khẩu (như cũ, chỉ xem + duyệt sản phẩm)
ACCOUNT_CLIENT_EMAIL=client@example.com
ACCOUNT_CLIENT_PASS=
ACCOUNT_CLIENT_NAME=Client

# ============================================
# Google Sheets (tùy chọn — dùng làm default values)
# ============================================
VITE_DEFAULT_SPREADSHEET_ID=
VITE_DEFAULT_OAUTH_CLIENT_ID=
